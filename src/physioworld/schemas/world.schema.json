{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/physioworld/world.schema.json",
  "title": "PhysioWorld synthetic signal world",
  "type": "object",
  "description": "Legacy-compatible synthetic sample replay. sample_rate is in Hz and timestamps are in seconds. Omitted metrics select the historical mean/rms smoke summaries.",
  "required": ["seed", "modality", "unit", "samples"],
  "not": {"anyOf": [{"required": ["vertical"]}, {"required": ["dataset"]}, {"required": ["experiment"]}]},
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "time_unit": {"const": "s"},
    "name": {"type": "string"},
    "seed": {"type": "integer"},
    "subject_id": {"type": "string"},
    "record_id": {"type": "string"},
    "modality": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "sample_rate": {"type": "number", "exclusiveMinimum": 0},
    "timestamps": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
    "samples": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "perturbations": {"type": "array", "items": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["additive_noise", "baseline_wander", "clipping", "missingness", "quantization", "sensor_drift", "motion_artifact", "electrode_artifact", "emg_contamination", "adc_saturation", "distribution_shift", "gain_error", "offset_error", "calibration_failure"]}, "seed": {"type": "integer"}}}},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "default": ["mean", "rms"], "items": {"enum": ["mean", "rms"]}}
  },
  "allOf": [
    {"if": {"not": {"required": ["timestamps"]}}, "then": {"required": ["sample_rate"]}}
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/physioworld/protocol.schema.json",
  "title": "PhysioWorld native declarative protocol",
  "description": "Strict versioned protocol data. Operations are typed nodes; values are data and are never evaluated as source code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "protocol_id", "seed", "clock", "limits", "metadata", "nodes", "emergency"],
  "properties": {
    "$schema": {"const": "protocol.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "protocol_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "clock": {"$ref": "#/$defs/clock"},
    "limits": {"$ref": "#/$defs/limits"},
    "metadata": {"type": "object"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "emergency": {"type": "array", "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "clock": {
      "type": "object", "additionalProperties": false, "required": ["time_unit", "horizon_s"],
      "properties": {"time_unit": {"const": "s"}, "horizon_s": {"type": "number", "exclusiveMinimum": 0}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_commands", "max_loop_iterations", "max_sweep_cases", "max_branch_depth", "max_emergency_commands"],
      "properties": {
        "max_commands": {"type": "integer", "minimum": 1},
        "max_loop_iterations": {"type": "integer", "minimum": 1},
        "max_sweep_cases": {"type": "integer", "minimum": 1},
        "max_branch_depth": {"type": "integer", "minimum": 1},
        "max_emergency_commands": {"type": "integer", "minimum": 1}
      }
    },
    "name": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "handler": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
    "at": {"type": "number", "minimum": 0},
    "parameters": {"type": "object"},
    "units": {"type": "object", "additionalProperties": {"$ref": "#/$defs/unit"}},
    "condition": {
      "type": "object", "additionalProperties": false, "required": ["left", "operator", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/operand"},
        "operator": {"enum": ["==", "!=", "<", "<=", ">", ">="]},
        "right": {"$ref": "#/$defs/operand"}
      }
    },
    "operand": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"$ref": "#/$defs/quantity"},
        {"type": "object", "additionalProperties": false, "required": ["$ref"], "properties": {"$ref": {"type": "string", "minLength": 1}}},
        {"$ref": "#/$defs/parameter_ref"}
      ]
    },
    "parameter_ref": {
      "type": "object", "additionalProperties": false, "required": ["$parameter"],
      "properties": {"$parameter": {"type": "string", "minLength": 1}}
    },
    "quantity": {
      "type": "object", "additionalProperties": false, "required": ["$quantity"],
      "properties": {"$quantity": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "number"}, "unit": {"$ref": "#/$defs/unit"}}}}
    },
    "children": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "node_base": {"type": "object", "required": ["op", "id"], "properties": {"op": {"type": "string"}, "id": {"type": "string", "minLength": 1}}},
    "setup": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "parameters", "units", "handler"],
      "properties": {"op": {"const": "setup"}, "id": {"$ref": "#/$defs/name"}, "parameters": {"$ref": "#/$defs/parameters"}, "units": {"$ref": "#/$defs/units"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "calibration": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "channel", "input_unit", "output_unit", "parameters", "units", "handler"],
      "properties": {"op": {"const": "calibration"}, "id": {"$ref": "#/$defs/name"}, "channel": {"$ref": "#/$defs/name"}, "input_unit": {"$ref": "#/$defs/unit"}, "output_unit": {"$ref": "#/$defs/unit"}, "parameters": {"$ref": "#/$defs/parameters"}, "units": {"$ref": "#/$defs/units"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "baseline": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "duration_s", "channels", "handler"],
      "properties": {"op": {"const": "baseline"}, "id": {"$ref": "#/$defs/name"}, "duration_s": {"type": "number", "exclusiveMinimum": 0}, "channels": {"type": "array", "items": {"$ref": "#/$defs/name"}}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "stimulus": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "actuator", "value", "unit", "duration_s", "handler"],
      "properties": {"op": {"const": "stimulus"}, "id": {"$ref": "#/$defs/name"}, "actuator": {"$ref": "#/$defs/name"}, "value": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/quantity"}, {"$ref": "#/$defs/parameter_ref"}]}, "unit": {"$ref": "#/$defs/unit"}, "duration_s": {"type": "number", "exclusiveMinimum": 0}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "acquire": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "channel", "sample_rate_hz", "duration_s", "parameters", "units", "handler"],
      "properties": {"op": {"const": "acquire"}, "id": {"$ref": "#/$defs/name"}, "channel": {"$ref": "#/$defs/name"}, "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0}, "duration_s": {"type": "number", "exclusiveMinimum": 0}, "parameters": {"$ref": "#/$defs/parameters"}, "units": {"$ref": "#/$defs/units"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "label", "attributes", "handler"],
      "properties": {"op": {"const": "event"}, "id": {"$ref": "#/$defs/name"}, "label": {"$ref": "#/$defs/name"}, "attributes": {"type": "object"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "wait": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "duration_s", "handler"],
      "properties": {"op": {"const": "wait"}, "id": {"$ref": "#/$defs/name"}, "duration_s": {"type": "number", "exclusiveMinimum": 0}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "computation": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "output", "output_unit", "inputs", "parameters", "units", "handler"],
      "properties": {"op": {"const": "computation"}, "id": {"$ref": "#/$defs/name"}, "output": {"$ref": "#/$defs/name"}, "output_unit": {"$ref": "#/$defs/unit"}, "inputs": {"type": "array", "items": {"$ref": "#/$defs/name"}}, "parameters": {"$ref": "#/$defs/parameters"}, "units": {"$ref": "#/$defs/units"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "condition", "then", "else", "handler"],
      "properties": {"op": {"const": "decision"}, "id": {"$ref": "#/$defs/name"}, "condition": {"$ref": "#/$defs/condition"}, "then": {"$ref": "#/$defs/children"}, "else": {"$ref": "#/$defs/children"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "if": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "condition", "then", "else"],
      "properties": {"op": {"const": "if"}, "id": {"$ref": "#/$defs/name"}, "condition": {"$ref": "#/$defs/condition"}, "then": {"$ref": "#/$defs/children"}, "else": {"$ref": "#/$defs/children"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "intervention": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "kind", "parameters", "units", "handler"],
      "properties": {"op": {"const": "intervention"}, "id": {"$ref": "#/$defs/name"}, "kind": {"$ref": "#/$defs/name"}, "parameters": {"$ref": "#/$defs/parameters"}, "units": {"$ref": "#/$defs/units"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "name", "value", "unit", "handler"],
      "properties": {"op": {"const": "resource"}, "id": {"$ref": "#/$defs/name"}, "name": {"$ref": "#/$defs/name"}, "value": {"oneOf": [{"type": ["string", "boolean", "number"]}, {"$ref": "#/$defs/quantity"}, {"$ref": "#/$defs/parameter_ref"}]}, "unit": {"$ref": "#/$defs/unit"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "measurement": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "name", "source", "unit", "parameters", "units", "handler"],
      "properties": {"op": {"const": "measurement"}, "id": {"$ref": "#/$defs/name"}, "name": {"$ref": "#/$defs/name"}, "source": {"$ref": "#/$defs/name"}, "unit": {"$ref": "#/$defs/unit"}, "parameters": {"$ref": "#/$defs/parameters"}, "units": {"$ref": "#/$defs/units"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "stop": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "reason", "condition", "emergency", "handler"],
      "properties": {"op": {"const": "stop"}, "id": {"$ref": "#/$defs/name"}, "reason": {"$ref": "#/$defs/name"}, "condition": {"oneOf": [{"$ref": "#/$defs/condition"}, {"type": "null"}]}, "emergency": {"type": "boolean"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "export": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "target", "format", "parameters", "handler"],
      "properties": {"op": {"const": "export"}, "id": {"$ref": "#/$defs/name"}, "target": {"$ref": "#/$defs/name"}, "format": {"$ref": "#/$defs/name"}, "parameters": {"$ref": "#/$defs/parameters"}, "handler": {"$ref": "#/$defs/handler"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "loop": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "count", "body"],
      "properties": {"op": {"const": "loop"}, "id": {"$ref": "#/$defs/name"}, "count": {"type": "integer", "minimum": 1}, "body": {"$ref": "#/$defs/children"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "schedule": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "mode", "repetitions", "cases"],
      "properties": {"op": {"const": "schedule"}, "id": {"$ref": "#/$defs/name"}, "mode": {"enum": ["sequential", "randomized", "counterbalanced"]}, "repetitions": {"type": "integer", "minimum": 1}, "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "nodes"], "properties": {"id": {"$ref": "#/$defs/name"}, "nodes": {"$ref": "#/$defs/children"}}}}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "sweep": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "parameters", "body"],
      "properties": {"op": {"const": "sweep"}, "id": {"$ref": "#/$defs/name"}, "parameters": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1}}, "body": {"$ref": "#/$defs/children"}, "at_s": {"$ref": "#/$defs/at"}}
    },
    "node": {
      "oneOf": [
        {"$ref": "#/$defs/setup"}, {"$ref": "#/$defs/calibration"}, {"$ref": "#/$defs/baseline"},
        {"$ref": "#/$defs/stimulus"}, {"$ref": "#/$defs/acquire"}, {"$ref": "#/$defs/event"},
        {"$ref": "#/$defs/wait"}, {"$ref": "#/$defs/computation"}, {"$ref": "#/$defs/decision"},
        {"$ref": "#/$defs/if"}, {"$ref": "#/$defs/intervention"}, {"$ref": "#/$defs/resource"},
        {"$ref": "#/$defs/measurement"}, {"$ref": "#/$defs/stop"}, {"$ref": "#/$defs/export"},
        {"$ref": "#/$defs/loop"}, {"$ref": "#/$defs/schedule"}, {"$ref": "#/$defs/sweep"}
      ]
    }
  }
}
